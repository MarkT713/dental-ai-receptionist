name: CI

on:
  push:
  pull_request:
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  quality-and-safety:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - uses: actions/setup-python@v7
        with:
          python-version: "3.12"
          cache: pip
      - name: Install development dependencies
        run: pip install -e '.[dev]'
      - name: Lint
        run: ruff check practice_management_software/intake_engine.py voice_pipeline scripts tests
      - name: Unit and API tests
        run: pytest -q
      - name: Intake safety evaluation gate
        run: python scripts/run_evals.py
      - name: Synthetic voice-turn simulation
        run: python scripts/run_voice_simulation.py
      - name: Public-release secret scan
        run: python scripts/secret_scan.py
      - name: Static security scan
        run: bandit -q -r practice_management_software voice_pipeline scripts -x tests -s B101
      - name: Dependency vulnerability audit
        run: pip-audit
      - name: Compile
        run: python -m compileall -q practice_management_software voice_pipeline scripts
      - name: Generate CycloneDX SBOM
        run: cyclonedx-py requirements requirements.lock --output-file sbom.json
      - uses: actions/upload-artifact@v7
        with:
          name: safety-eval-and-sbom
          path: |
            evals/latest-report.json
            sbom.json

  container:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v7
      - name: Build image
        run: docker build -t dental-ai-receptionist:test .
      - name: Verify non-root runtime and health
        run: |
          docker run -d --rm --name dental-ai-ci -p 127.0.0.1:18000:8000 dental-ai-receptionist:test
          for i in $(seq 1 20); do
            curl --fail --silent http://127.0.0.1:18000/health && break
            sleep 1
          done
          test "$(docker inspect dental-ai-ci --format '{{.Config.User}}')" = "10001:10001"
          curl --fail --silent http://127.0.0.1:18000/metadata
          docker stop dental-ai-ci
