name: CI

on:
  push:
  pull_request:

permissions:
  contents: read

jobs:
  test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip
      - name: Install
        run: pip install -e '.[dev]'
      - name: Lint
        run: ruff check practice_management_software/intake_engine.py voice_pipeline scripts tests
      - name: Test
        run: pytest -q
      - name: Evaluate intake safety
        run: python scripts/run_evals.py
      - name: Compile
        run: python -m compileall -q practice_management_software voice_pipeline scripts

  container:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - name: Build image
        run: docker build -t dental-ai-receptionist:test .
