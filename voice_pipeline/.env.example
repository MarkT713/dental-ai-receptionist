# Synthetic/local defaults
AI_PROVIDER=deterministic
ALLOW_CLOUD_SYNTHETIC_DATA=false
DENTAL_SEED_DEMO_DATA=true
DENTAL_DEMO_MODE=true
DENTAL_PUBLIC_SANDBOX=false
DENTAL_AUTO_RESET_MINUTES=0
DENTAL_AUTH_MODE=disabled
DENTAL_RATE_LIMIT_PER_MINUTE=240
DENTAL_DB_PATH=./practice_management_software/pms.db
DENTAL_PRACTICE_NAME=BrightSmile Dental

# Optional role-token mode. Generate unique random values outside chat/version control.
DENTAL_VIEWER_TOKEN=set_a_random_viewer_token
DENTAL_STAFF_TOKEN=set_a_different_random_staff_token
DENTAL_MANAGER_TOKEN=set_a_different_random_manager_token

# Optional OpenAI-compatible adapter; synthetic transcripts only.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=[REDACTED]
LLM_MODEL=gpt-4.1-mini

# Voice state machine / mock PMS client
PMS_BASE_URL=http://localhost:8000
PMS_API_TOKEN=[REDACTED]
PMS_PROVIDER=Dr. Rivera DDS
PMS_CHAIR=Chair 1
PRACTICE_NAME=BrightSmile Dental
RECEPTIONIST_NAME=Ava
DENTAL_RECEPTIONIST_MODE=after_hours
ALLOW_UNSAFE_DIRECT_BOOKING_DEMO=false
STAFF_EXTENSION=100
